<!-- Loaded only when the (optional) org.jetbrains.plugins.terminal dependency is
     enabled — see the <depends optional="true"> entry in plugin.xml. -->
<idea-plugin>
  <!-- Do NOT remove: a config-file sub-descriptor does not inherit the main
       descriptor's <resource-bundle>, so this action's text/description
       (action.ClaudeCommit.SendCcReference.*) only localize when the bundle is
       declared here too. Redeclaring the SAME bundle name is the platform's own
       convention (cf. the Kotlin plugin) and raises no "redefinition" warning —
       that warning only fires on a *conflicting* bundle value. -->
  <resource-bundle>messages.ClaudeCommitBundle</resource-bundle>
  <!-- Hides the Terminal tool window while the project closes, when the user opts in.
       Registered here (not in the main descriptor) so it loads only with the Terminal
       plugin — see CloseTerminalOnProjectCloseListener. ProjectCloseListener.TOPIC is
       @Topic.AppLevel, hence <applicationListeners> rather than <projectListeners>. -->
  <applicationListeners>
    <listener class="com.github.claudecommit.CloseTerminalOnProjectCloseListener"
              topic="com.intellij.openapi.project.ProjectCloseListener"/>
  </applicationListeners>
  <extensions defaultExtensionNs="com.intellij">
    <!-- Cmd/Alt+N is also the IDE's "Activate <X> Tool Window" shortcut. Both actions
         end up enabled for the same keystroke, and a promoter is the platform's way
         of deciding the winner — see SwitchTerminalTabActionPromoter. -->
    <actionPromoter implementation="com.github.claudecommit.SwitchTerminalTabActionPromoter"/>
  </extensions>
  <!-- The Reworked Terminal only lets the shortcuts of an allow-list of IDE actions
       through to the action system; everything else is typed into the shell. This
       adds the project-switch actions to that list so Option+N works from inside a
       Claude Code session — see SwitchProjectWindowAllowedActionsProvider. -->
  <extensions defaultExtensionNs="org.jetbrains.plugins.terminal">
    <allowedActionsProvider implementation="com.github.claudecommit.SwitchProjectWindowAllowedActionsProvider"/>
  </extensions>
  <actions>
    <action id="ClaudeCommit.SendCcReference"
            class="com.github.claudecommit.SendCcReferenceAction"
            icon="/icons/claude.svg">
      <add-to-group group-id="ClaudeCommit.CcReferenceGroup" anchor="after"
                    relative-to-action="ClaudeCommit.CopyCcReference"/>
      <!-- Cmd+Option+K on Mac, Ctrl+Alt+K elsewhere ("Mac OS X 10.5+" is the
           internal id of the macOS keymap, which otherwise inherits $default).
           replace-all drops the inherited ctrl alt K so the Mac keymap only
           binds meta alt K. -->
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt K"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt K" replace-all="true"/>
    </action>
    <!-- Switch to the N-th terminal tab, but only while the terminal has the focus;
         everywhere else these keystrokes keep opening the numbered tool windows.
         One action per digit because the platform instantiates a registered action
         through a no-argument constructor. replace-all on the Mac keymap drops the inherited
         alt N (which types special characters on macOS) so only meta N is bound. -->
    <action id="ClaudeCommit.SwitchTerminalTab1" class="com.github.claudecommit.SwitchTerminalTab1">
      <keyboard-shortcut keymap="$default" first-keystroke="alt 1"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta 1" replace-all="true"/>
    </action>
    <action id="ClaudeCommit.SwitchTerminalTab2" class="com.github.claudecommit.SwitchTerminalTab2">
      <keyboard-shortcut keymap="$default" first-keystroke="alt 2"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta 2" replace-all="true"/>
    </action>
    <action id="ClaudeCommit.SwitchTerminalTab3" class="com.github.claudecommit.SwitchTerminalTab3">
      <keyboard-shortcut keymap="$default" first-keystroke="alt 3"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta 3" replace-all="true"/>
    </action>
    <action id="ClaudeCommit.SwitchTerminalTab4" class="com.github.claudecommit.SwitchTerminalTab4">
      <keyboard-shortcut keymap="$default" first-keystroke="alt 4"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta 4" replace-all="true"/>
    </action>
    <action id="ClaudeCommit.SwitchTerminalTab5" class="com.github.claudecommit.SwitchTerminalTab5">
      <keyboard-shortcut keymap="$default" first-keystroke="alt 5"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta 5" replace-all="true"/>
    </action>
    <action id="ClaudeCommit.SwitchTerminalTab6" class="com.github.claudecommit.SwitchTerminalTab6">
      <keyboard-shortcut keymap="$default" first-keystroke="alt 6"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta 6" replace-all="true"/>
    </action>
    <action id="ClaudeCommit.SwitchTerminalTab7" class="com.github.claudecommit.SwitchTerminalTab7">
      <keyboard-shortcut keymap="$default" first-keystroke="alt 7"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta 7" replace-all="true"/>
    </action>
    <action id="ClaudeCommit.SwitchTerminalTab8" class="com.github.claudecommit.SwitchTerminalTab8">
      <keyboard-shortcut keymap="$default" first-keystroke="alt 8"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta 8" replace-all="true"/>
    </action>
    <action id="ClaudeCommit.SwitchTerminalTab9" class="com.github.claudecommit.SwitchTerminalTab9">
      <keyboard-shortcut keymap="$default" first-keystroke="alt 9"/>
      <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta 9" replace-all="true"/>
    </action>
  </actions>
</idea-plugin>
